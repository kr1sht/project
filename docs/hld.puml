
@startuml
title StudyCards - High Level Architecture

left to right direction
skinparam componentStyle rectangle

actor "Пользователь" as User

package "StudyCards" {
  [Веб-интерфейс\nFrontend] as Frontend
  [Backend API] as API

  component "Авторизация" as Auth
  component "Обработка конспектов" as Notes
  component "Генерация карточек" as Generator
  component "Управление карточками\nи наборами" as Cards
  component "Отслеживание прогресса" as Progress

  database "База данных\nPostgreSQL" as DB
}

User --> Frontend
Frontend --> API
API --> Auth
API --> Notes
API --> Generator
API --> Cards
API --> Progress

Auth --> DB
Notes --> DB
Generator --> DB
Cards --> DB
Progress --> DB

@enduml
